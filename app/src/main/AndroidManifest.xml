<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:name=".MomentusApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Momentus"
        tools:targetApi="31">

        <activity
            android:name=".ui.screens.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.Momentus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.screens.MainActivity" android:exported="false" />
        <activity android:name=".ui.screens.CalendarActivity" android:exported="false" />
        <activity android:name=".ui.screens.CreateTemplateActivity" android:exported="false" />
        <activity android:name=".ui.screens.EditorRotinaComposeActivity" android.exported="false" />
        <activity android:name=".ui.screens.TemplatesActivity" android:exported="false" />
        <activity android:name=".ui.screens.TemplateDetailActivity" android:exported="false" />
        <activity android:name=".ui.screens.CategoryActivity" android:exported="false" />

        <receiver
            android:name=".notifications.AlarmReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true"
            tools:ignore="UnusedAttribute" />

        <!-- Widget Clássico -->
        <receiver
            android:name=".widget.MomentusWidgetProvider"
            android:exported="false"
            android:directBootAware="true"
            tools:ignore="UnusedAttribute">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="br.com.fabriciolima.momentus.action.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/momentus_widget_info" />
        </receiver>

        <service
            android:name=".widget.WidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:directBootAware="true"
            tools:ignore="UnusedAttribute" />

    </application>

</manifest>
